{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "*.html",
          "*.css",
          "*.js",
          "*.json"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(index|login|signup|analyzer|signals|chart|calculator|history|profit-cards|admin-subscriptions|vip-signals)\\.html",
      "dest": "/server.js"
    },
    {
      "src": "/(style\\.css|auth\\.js|login\\.js|signup\\.js|script\\.js|analysis\\.js|advanced-chart\\.js|sw\\.js)",
      "dest": "/server.js"
    }
  ]
}